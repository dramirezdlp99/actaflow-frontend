# ActaFlow - Frontend (BFF de Next.js)
# Todas son variables de SERVIDOR: nunca uses el prefijo NEXT_PUBLIC_ para ellas,
# porque terminarian dentro del JavaScript que descarga el navegador.
# En Windows guardalas como variables de usuario y reinicia la terminal.

# live (por defecto): llama a los microservicios. mock: respuestas simuladas y tipadas desde el
# contrato, para trabajar en el frontend sin levantar ningun servicio.
ACTAFLOW_RPC_MODE=live

# grpc: gRPC nativo sobre HTTP/2 (local). grpc-web (por defecto): HTTP/1.1 (Vercel -> Render Free).
ACTAFLOW_RPC_TRANSPORT=grpc

# URLs reales de los microservicios. El navegador nunca las ve: solo las usa el BFF.
# Con grpc apuntan al puerto gRPC nativo; con grpc-web, al puerto web.
#   identity-service:   grpc http://localhost:9198 | grpc-web http://localhost:9098
#   legal-case-service: grpc http://localhost:9197 | grpc-web http://localhost:9097
ACTAFLOW_IDENTITY_URL=http://localhost:9198
ACTAFLOW_LEGAL_CASE_URL=http://localhost:9197

# Un secreto HMAC por par (minimo 32 caracteres, distintos entre si y entre local y produccion).
# Mismo nombre y mismo valor que en cada servicio del backend.
ACTAFLOW_IDENTITY_HMAC_SECRET=
ACTAFLOW_LEGAL_CASE_HMAC_SECRET=

# Tiempo maximo que el BFF espera a un servicio dormido (Render Free tarda ~1 min), en ms.
ACTAFLOW_BACKEND_WAIT_MS=120000
