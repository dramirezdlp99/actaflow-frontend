# ActaFlow - Frontend (BFF de Next.js)
# Todas son variables de SERVIDOR: nunca uses el prefijo NEXT_PUBLIC_ para ellas,
# porque terminarian dentro del JavaScript que descarga el navegador.

# URL real del backend. El navegador nunca la ve: solo la usa el BFF.
ACTAFLOW_BACKEND_URL=http://localhost:9097

# Secreto HMAC con el que el BFF firma cada peticion al backend (minimo 32 caracteres).
# Debe ser igual a ACTAFLOW_BFF_HMAC_SECRET del backend. Distinto en local y produccion.
ACTAFLOW_BFF_HMAC_SECRET=

# Tiempo maximo que el BFF espera a un backend dormido (Render Free tarda ~1 min), en ms.
ACTAFLOW_BACKEND_WAIT_MS=120000
